{
  "name": "bvps-school-website",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/bvps-website",
    "build": "npm run build --workspace=@workspace/bvps-website",
    "start": "node artifacts/api-server/build.mjs && node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
